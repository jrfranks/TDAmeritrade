	    "options":null,
	    "description":"'The type of request:<br><br><code>symbol-search<\/code>: Retrieve instrument data of a specific symbol or cusip<br><br><code>symbol-regex<\/code>: Retrieve instrument data for all symbols matching regex. Example: <code>symbol=XYZ.*<\/code> will return all symbols beginning with XYZ<br><br><code>desc-search<\/code>: Retrieve instrument data for instruments whose description contains the word supplied. Example: <code>symbol=FakeCompany<\/code> will return all instruments with FakeCompany in the description.<br><br><code>desc-regex<\/code>: Search description with full regex support. Example: <code>symbol=XYZ.[A-C]<\/code> returns all instruments whose descriptions contain a word beginning with XYZ followed by a character A through C.<br><br><code>fundamental<\/code>: Returns fundamental data for a single instrument specified by exact symbol.'",
	    "type":"query",
	    "items":null,
	    "required":true
	  }
