GetQuotes_api = %{
  schema: => [
  description: "Get quote for one or more symbols",
  errors: [
    {"400", "An error message indicating the caller must pass a non null value in the parameter."},
    {"401", "An error message indicating the caller must pass a valid Authorization in the HTTP authorization request header."},
    {"403", "An error message indicating the caller is forbidden from accessing this page."},
    {"404", "An error message indicating the instrument for the symbol/cusip was not found."},
    {"406", "An error message indicating an issue in the symbol regex, or number of symbols searched is over the maximum."}
  ],
  name: "Get Quotes",
  query_parameters: [
    {"Authorization", "string",
     "(Optional) The Authorization token to validate the request.  Not required for un-authenticated requests.  Not required if using below 'OAuth 2.0 Set' link to do the authentication."},
    {"apikey", "string", "Pass your <b>OAuth User ID </b>to make an unauthenticated request for delayed data."},
    {"symbol", "string", "Enter one or more symbols separated by commas"}
  ],
  response_schema: [{"type", "array"}],
  rest_action: "GET",
  rest_url: "https://api.tdameritrade.com/v1/marketdata/quotes",
  security_schema: [{"oauthsecurity", [{"grantType", "AUTHORIZATION_CODE"}, {"type", "OAUTH2"}]}]
]
  , dict: => %{}
}
