GetInstrument_api = %{
  schema: => [
  description: "Get an instrument by CUSIP",
  errors: [
    {"401", "Unauthorized"},
    {"403", "Forbidden"},
    {"404", "An error message indicating the instrument for the symbol/cusip was not found."}
  ],
  name: "Get Instrument",
  query_parameters: [
    {"Authorization", "string",
     "Supply an access token to make an authenticated request. The format is <code>Bearer &lt;access token&gt;</code>."},
    {"apikey", "string", "Pass your <b>OAuth User ID</b>to make an unauthenticated request for delayed data."},
    {"cusip", "string", "cusip"}
  ],
  response_schema: [{"type", "array"}],
  rest_action: "GET",
  rest_url: "https://api.tdameritrade.com/v1/instruments/\#{cusip}",
  security_schema: [{"oauthsecurity", [{"grantType", "AUTHORIZATION_CODE"}, {"type", "OAUTH2"}]}]
]
  , dict: => %{}
}
